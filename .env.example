# ==============================================================================
# Pipeline as Code: Environment Configuration Template (Phase I & II Lakehouse)
# Copy this file to .env and adjust variables for your local or production setup.
# DO NOT commit real secrets (.env) to version control.
# ==============================================================================

# Database Connection (PostgreSQL - Phase I)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=earbuds_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Kafka Message Broker & Streaming Topics (Phase II)
KAFKA_SERVER=localhost:9092
KAFKA_TOPIC=earbuds_events
KAFKA_STREAM_TOPIC=earbuds_stream
KAFKA_DLQ_TOPIC=earbuds_dlq

# MinIO Object Store (S3-Compatible Lakehouse Storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=lakehouse

# Apache Iceberg REST Catalog
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3a://lakehouse/
ICEBERG_CATALOG_NAME=lakehouse
ICEBERG_DATABASE_NAME=earbuds

# Trino Distributed SQL Query Engine
TRINO_HOST=localhost
TRINO_PORT=8085
TRINO_USER=admin
TRINO_CATALOG=iceberg
TRINO_SCHEMA=earbuds

# Airflow Orchestrator
AIRFLOW_URL=http://localhost:8082
AIRFLOW_DAG_ID=earbuds_rough_to_staging
AIRFLOW_MAINTENANCE_DAG_ID=iceberg_table_maintenance
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin123

# Monitoring & Alerting (Slack / Email)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SMTP_SERVER=smtp.example.com
ALERT_EMAIL=alerts@example.com
ALERTS_ENABLED=false

# Pipeline Settings
BATCH_SIZE=500
LOG_LEVEL=INFO
